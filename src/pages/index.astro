---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="AlexaVolt | Electrician Autorizat ANRE Iași — Instalații Electrice Profesionale" description="Cauți un electrician autorizat în Iași? AlexaVolt oferă servicii complete de instalații electrice, tablouri Schneider și sisteme fotovoltaice pentru rezidențial și firme. Solicită deviz gratuit.">
	<Header />
	
	<main class="font-sans text-slate-800">

		<!-- HERO -->
		<section class="relative overflow-hidden bg-gradient-to-b from-brand-50 to-white">
			<div class="max-w-4xl mx-auto px-6 pt-14 pb-16 md:pt-20 md:pb-20 text-center">
				<span class="inline-flex items-center gap-2 bg-urgent-100 text-urgent-700 font-bold text-sm px-4 py-1.5 rounded-full mb-6">
					⚡ Intervenții rapide în Iași
				</span>
				<h1 class="text-4xl md:text-6xl font-extrabold text-slate-900 mb-5 leading-[1.1] tracking-tight">
					A picat curentul?<br />
					<span class="text-brand-600">Electrician autorizat</span>, la un telefon distanță.
				</h1>
				<p class="text-lg md:text-xl leading-relaxed text-slate-600 max-w-2xl mx-auto mb-8">
					AlexaVolt — electricieni autorizați ANRE în Iași. De la o priză arsă până la instalația completă a casei, rezolvăm sigur și la normă.
				</p>

				<!-- CTA dublu -->
				<div class="flex flex-col sm:flex-row gap-3 justify-center items-stretch max-w-lg mx-auto">
					<a href="tel:+40745539432" class="flex-1 inline-flex items-center justify-center gap-2 bg-urgent-600 text-white px-8 py-4 rounded-full text-lg font-bold hover:bg-urgent-700 transition-all shadow-lg shadow-urgent-100 hover:-translate-y-0.5">
						📞 Sună acum
					</a>
					<a href={`${base}/contact/`} class="flex-1 inline-flex items-center justify-center gap-2 bg-white text-brand-700 border-2 border-brand-200 px-8 py-4 rounded-full text-lg font-bold hover:border-brand-400 hover:bg-brand-50 transition-all">
						Cere deviz gratuit
					</a>
				</div>

				<!-- Trust signals -->
				<div class="mt-8 flex flex-wrap gap-2 justify-center text-sm font-semibold text-slate-600">
					<span class="bg-white border border-slate-200 px-4 py-2 rounded-full shadow-sm">✓ Autorizat ANRE Tip B</span>
					<span class="bg-white border border-slate-200 px-4 py-2 rounded-full shadow-sm">✓ Conform Normativ I7</span>
					<span class="bg-white border border-slate-200 px-4 py-2 rounded-full shadow-sm">✓ Aparataj Schneider</span>
					<span class="bg-white border border-slate-200 px-4 py-2 rounded-full shadow-sm">✓ Garanție 2 ani</span>
				</div>
			</div>
		</section>

		<div class="max-w-5xl mx-auto px-6 py-16">

		<!-- SERVICII -->
		<section class="mb-20">
			<div class="text-center mb-10">
				<h2 class="text-3xl md:text-4xl font-extrabold text-slate-900">Cu ce te ajutăm</h2>
				<p class="text-slate-500 mt-2">Servicii electrice complete, pentru casă sau firmă.</p>
			</div>

			<div class="grid gap-5 sm:grid-cols-2">
				<a href={`${base}/servicii/instalatii-electrice-complete/`} class="group bg-white p-7 rounded-3xl border border-slate-100 shadow-sm hover:shadow-xl hover:border-brand-200 hover:-translate-y-1 transition-all">
					<div class="w-12 h-12 rounded-2xl bg-brand-50 flex items-center justify-center text-2xl mb-4">🏗️</div>
					<h3 class="text-lg font-bold mb-1 text-slate-900">Instalații electrice complete</h3>
					<p class="text-sm text-slate-600">Case noi, apartamente și spații comerciale — proiectare și execuție conform Normativ I7.</p>
					<span class="inline-block mt-4 text-brand-600 font-semibold text-sm group-hover:translate-x-1 transition-transform">Detalii →</span>
				</a>

				<a href={`${base}/servicii/tablouri-electrice-schneider/`} class="group bg-white p-7 rounded-3xl border border-slate-100 shadow-sm hover:shadow-xl hover:border-brand-200 hover:-translate-y-1 transition-all">
					<div class="w-12 h-12 rounded-2xl bg-brand-50 flex items-center justify-center text-2xl mb-4">⚙️</div>
					<h3 class="text-lg font-bold mb-1 text-slate-900">Tablouri electrice Schneider</h3>
					<p class="text-sm text-slate-600">Aparataj Schneider Electric — protecții RCD, SPD și disjunctoare calibrate pe consumul real.</p>
					<span class="inline-block mt-4 text-brand-600 font-semibold text-sm group-hover:translate-x-1 transition-transform">Detalii →</span>
				</a>

				<a href={`${base}/servicii/panouri-fotovoltaice/`} class="group bg-solar-50 p-7 rounded-3xl border border-solar-100 shadow-sm hover:shadow-xl hover:border-solar-600/30 hover:-translate-y-1 transition-all">
					<div class="w-12 h-12 rounded-2xl bg-white flex items-center justify-center text-2xl mb-4">☀️</div>
					<h3 class="text-lg font-bold mb-1 text-slate-900">Panouri fotovoltaice</h3>
					<p class="text-sm text-slate-600">Sisteme la cheie — devii prosumator și îți reduci factura la energie.</p>
					<span class="inline-block mt-4 text-solar-700 font-semibold text-sm group-hover:translate-x-1 transition-transform">Detalii →</span>
				</a>

				<a href={`${base}/servicii/verificare-pram/`} class="group bg-white p-7 rounded-3xl border border-slate-100 shadow-sm hover:shadow-xl hover:border-brand-200 hover:-translate-y-1 transition-all">
					<div class="w-12 h-12 rounded-2xl bg-brand-50 flex items-center justify-center text-2xl mb-4">📄</div>
					<h3 class="text-lg font-bold mb-1 text-slate-900">Verificare PRAM</h3>
					<p class="text-sm text-slate-600">Buletin de verificare pentru vânzare imobil, racordare sau renovare majoră.</p>
					<span class="inline-block mt-4 text-brand-600 font-semibold text-sm group-hover:translate-x-1 transition-transform">Detalii →</span>
				</a>
			</div>
		</section>

		<!-- DOVADĂ SOCIALĂ / ÎNCREDERE -->
		<section class="mb-20 bg-slate-900 text-white rounded-[2rem] p-8 md:p-12">
			<div class="grid sm:grid-cols-3 gap-8 text-center">
				<div>
					<p class="text-3xl font-extrabold text-brand-400">ANRE</p>
					<p class="text-slate-400 text-sm mt-1">Electrician autorizat Tip B</p>
				</div>
				<div>
					<p class="text-3xl font-extrabold text-brand-400">2 ani</p>
					<p class="text-slate-400 text-sm mt-1">Garanție pentru manoperă</p>
				</div>
				<div>
					<p class="text-3xl font-extrabold text-brand-400">Iași</p>
					<p class="text-slate-400 text-sm mt-1">Tot orașul și județul</p>
				</div>
			</div>
		</section>

		<!-- URGENȚE -->
		<section class="mb-20">
			<div class="bg-urgent-50 border border-urgent-100 rounded-[2rem] p-8 md:p-10">
				<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
					<div>
						<h2 class="text-2xl md:text-3xl font-extrabold text-slate-900">⚡ Ai o urgență electrică?</h2>
						<p class="text-slate-600 mt-1">Diagnosticăm și rezolvăm rapid în Iași și împrejurimi.</p>
					</div>
					<a href="tel:+40745539432" class="inline-flex items-center justify-center gap-2 bg-urgent-600 text-white px-7 py-3.5 rounded-full font-bold hover:bg-urgent-700 transition-all shadow-lg shadow-urgent-100 whitespace-nowrap">
						📞 Sună acum
					</a>
				</div>
				<div class="grid grid-cols-2 md:grid-cols-4 gap-3">
					<a href={`${base}/articole/de-ce-imi-sare-diferentialul/`} class="bg-white p-4 rounded-2xl border border-slate-100 text-center hover:border-urgent-200 hover:shadow-md transition-all group">
						<p class="font-bold text-sm text-slate-800 group-hover:text-urgent-700">Sare diferențialul</p>
					</a>
					<a href={`${base}/articole/nu-am-curent-pe-o-parte-din-casa/`} class="bg-white p-4 rounded-2xl border border-slate-100 text-center hover:border-urgent-200 hover:shadow-md transition-all group">
						<p class="font-bold text-sm text-slate-800 group-hover:text-urgent-700">Lipsă curent parțială</p>
					</a>
					<a href={`${base}/articole/miros-de-ars-priza-tablou/`} class="bg-white p-4 rounded-2xl border border-slate-100 text-center hover:border-urgent-200 hover:shadow-md transition-all group">
						<p class="font-bold text-sm text-slate-800 group-hover:text-urgent-700">Miros de ars</p>
					</a>
					<a href={`${base}/articole/tensiune-mica-in-casa/`} class="bg-white p-4 rounded-2xl border border-slate-100 text-center hover:border-urgent-200 hover:shadow-md transition-all group">
						<p class="font-bold text-sm text-slate-800 group-hover:text-urgent-700">Tensiune mică</p>
					</a>
				</div>
			</div>
		</section>

		<!-- ZONĂ DE ACOPERIRE -->
		<section class="mb-20 text-center">
			<h2 class="text-2xl font-bold mb-3 text-slate-900">📍 Zonă de acoperire</h2>
			<p class="text-slate-600 leading-relaxed max-w-3xl mx-auto">
				Iași și tot județul: Miroslava, Ciurea, Tomești, Valea Lupului, Copou, Bucium, Galata, Popricani, Rediu, Nicolina, CUG, Tătărași și toate cartierele. Rezidențial, comercial și industrial.
			</p>
		</section>

		<!-- CTA FINAL -->
		<section class="text-center bg-gradient-to-b from-brand-50 to-white border border-brand-100 rounded-[2rem] py-12 px-6">
			<h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 mb-3">Cere un deviz gratuit</h2>
			<p class="mb-8 text-slate-600 max-w-xl mx-auto">Venim la fața locului, analizăm și îți oferim un deviz clar — fără obligații și fără surprize.</p>
			<div class="flex flex-col sm:flex-row gap-3 justify-center max-w-lg mx-auto">
				<a href="tel:+40745539432" class="flex-1 inline-flex items-center justify-center gap-2 bg-urgent-600 text-white px-8 py-4 rounded-full text-lg font-bold hover:bg-urgent-700 transition-all shadow-lg hover:-translate-y-0.5">
					📞 Sună acum
				</a>
				<a href={`${base}/contact/`} class="flex-1 inline-flex items-center justify-center gap-2 bg-brand-600 text-white px-8 py-4 rounded-full text-lg font-bold hover:bg-brand-700 transition-all shadow-lg hover:-translate-y-0.5">
					Cere deviz gratuit
				</a>
			</div>
		</section>

		</div>
	</main>

	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "Electrician",
		"name": "AlexaVolt",
		"description": "Electrician autorizat ANRE Iași - instalații electrice profesionale, tablouri Schneider, sisteme fotovoltaice",
		"url": "https://www.alexavolt.ro",
		"telephone": "+40745539432",
		"email": "alexamarius@yahoo.com",
		"address": {
			"@type": "PostalAddress",
			"addressLocality": "Iași",
			"addressRegion": "Iași",
			"addressCountry": "RO"
		},
		"geo": {
			"@type": "GeoCoordinates",
			"latitude": 47.1585,
			"longitude": 27.6014
		},
		"areaServed": {
			"@type": "City",
			"name": "Iași"
		},
		"priceRange": "$$",
		"openingHours": "Mo-Fr 08:00-18:00, Sa 09:00-14:00",
		"sameAs": ["https://wa.me/40745539432"]
	})} />
</Layout>
