---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Subvenții și finanțare fotovoltaice — surse oficiale | AlexaVolt" description="Programe de finanțare pentru panouri fotovoltaice în România (Casa Verde, Electric Up, credite verzi). Îndrumare către sursele oficiale AFM, ANRE și programele guvernamentale.">
  <Header />

  <main class="max-w-4xl mx-auto px-6 py-12 font-sans text-slate-800">

    <Breadcrumb pagina="Subvenții fotovoltaice" parent="📚 Ghid Practic" parentHref={`${base}/articole/`} />

    <article>
      <header class="mb-12 border-b border-slate-100 pb-10">
        <h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 mb-4 leading-tight">
          Subvenții și finanțare <span class="text-emerald-600">fotovoltaice</span>: de unde te informezi
        </h1>
        <p class="text-lg text-slate-600 leading-relaxed">
          Programele de finanțare pentru panouri solare (Casa Verde, Electric Up, credite verzi) se schimbă frecvent — plafoane, sesiuni și condiții de eligibilitate diferă de la un an la altul. Ca să ai mereu informația corectă și la zi, cel mai sigur e să consulți direct sursele oficiale.
        </p>
      </header>

      <section class="mb-12">
        <div class="bg-amber-50 p-6 rounded-2xl border border-amber-100">
          <h2 class="text-lg font-bold text-amber-900 mb-2 flex items-center gap-2">
            <span>⚠️</span> De ce trimitem către sursele oficiale
          </h2>
          <p class="text-sm text-slate-700 leading-relaxed">
            Condițiile programelor de finanțare (bugete, plafoane, date de depunere, cine e eligibil) sunt stabilite și actualizate de instituțiile statului. Pentru a evita informații depășite, nu publicăm aici cifre care se pot schimba peste noapte. Verifică întotdeauna statusul curent pe paginile oficiale de mai jos înainte de a lua o decizie.
          </p>
        </div>
      </section>

      <section class="mb-12">
        <h2 class="text-2xl font-bold text-slate-900 mb-6 flex items-center gap-2">
          <span>🏛️</span> Surse oficiale — programe de finanțare
        </h2>
        <div class="space-y-4">
          <div class="bg-blue-50 p-5 rounded-2xl border border-blue-100">
            <a href="https://www.afm.ro/" target="_blank" rel="noopener noreferrer" class="text-blue-700 font-bold hover:text-blue-900 transition-colors">
              AFM — Administrația Fondului pentru Mediu ↗
            </a>
            <p class="text-sm text-slate-600 mt-1">
              Instituția care administrează programul Casa Verde (fotovoltaice și stocare). Aici găsești ghidurile de finanțare, sesiunile active, calendarul de depunere și lista instalatorilor validați.
            </p>
          </div>

          <div class="bg-blue-50 p-5 rounded-2xl border border-blue-100">
            <a href="https://www.mmediu.ro/" target="_blank" rel="noopener noreferrer" class="text-blue-700 font-bold hover:text-blue-900 transition-colors">
              Ministerul Mediului, Apelor și Pădurilor ↗
            </a>
            <p class="text-sm text-slate-600 mt-1">
              Ministerul care stabilește politicile și programele de finanțare pentru energie verde și eficiență energetică.
            </p>
          </div>

          <div class="bg-blue-50 p-5 rounded-2xl border border-blue-100">
            <a href="https://program-electricup.ro/" target="_blank" rel="noopener noreferrer" class="text-blue-700 font-bold hover:text-blue-900 transition-colors">
              Electric Up — program pentru IMM-uri și HORECA ↗
            </a>
            <p class="text-sm text-slate-600 mt-1">
              Program guvernamental de finanțare pentru firme care instalează sisteme fotovoltaice și stații de încărcare pentru vehicule electrice.
            </p>
          </div>

          <div class="bg-blue-50 p-5 rounded-2xl border border-blue-100">
            <a href="https://mfe.gov.ro/" target="_blank" rel="noopener noreferrer" class="text-blue-700 font-bold hover:text-blue-900 transition-colors">
              Ministerul Investițiilor și Proiectelor Europene (PNRR) ↗
            </a>
            <p class="text-sm text-slate-600 mt-1">
              Fonduri europene și componente PNRR pentru energie regenerabilă, accesibile în special pentru firme și autorități.
            </p>
          </div>
        </div>
      </section>

      <section class="mb-12">
        <h2 class="text-2xl font-bold text-slate-900 mb-6 flex items-center gap-2">
          <span>⚡</span> Surse oficiale — statutul de prosumator și energie
        </h2>
        <div class="space-y-4">
          <div class="bg-blue-50 p-5 rounded-2xl border border-blue-100">
            <a href="https://www.anre.ro/" target="_blank" rel="noopener noreferrer" class="text-blue-700 font-bold hover:text-blue-900 transition-colors">
              ANRE — Autoritatea Națională de Reglementare în domeniul Energiei ↗
            </a>
            <p class="text-sm text-slate-600 mt-1">
              Reglementările privind prosumatorii, racordarea la rețea, compensarea energiei injectate și tarifele. Aici se publică legislația și modificările în vigoare.
            </p>
          </div>

          <div class="bg-blue-50 p-5 rounded-2xl border border-blue-100">
            <a href="https://www.anaf.ro/" target="_blank" rel="noopener noreferrer" class="text-blue-700 font-bold hover:text-blue-900 transition-colors">
              ANAF — regimul TVA și fiscalitate ↗
            </a>
            <p class="text-sm text-slate-600 mt-1">
              Pentru cota de TVA aplicabilă echipamentelor și lucrărilor fotovoltaice, consultă legislația fiscală în vigoare sau discută cu un contabil autorizat.
            </p>
          </div>
        </div>
      </section>

      <section class="mb-12 bg-slate-50 p-6 rounded-2xl border border-slate-100">
        <h2 class="text-xl font-bold text-slate-900 mb-4">📖 Articole similare</h2>
        <ul class="space-y-2">
          <li><a href={`${base}/articole/ghid-prosumator/`} class="text-blue-600 font-semibold hover:text-blue-800 transition-colors">Ghid complet prosumator →</a></li>
          <li><a href={`${base}/articole/amortizare-sistem-fotovoltaic/`} class="text-blue-600 font-semibold hover:text-blue-800 transition-colors">Amortizarea unui sistem fotovoltaic →</a></li>
          <li><a href={`${base}/articole/fotovoltaice-cu-baterie-vs-fara/`} class="text-blue-600 font-semibold hover:text-blue-800 transition-colors">Fotovoltaice cu baterie vs fără — ce merită →</a></li>
        </ul>
      </section>

      <section class="text-center border-t border-slate-100 pt-10">
        <h2 class="text-2xl font-bold mb-4 text-slate-900">Vrei să afli ce soluție e potrivită pentru tine?</h2>
        <p class="text-slate-600 mb-8 max-w-2xl mx-auto">
          AlexaVolt te ajută cu dimensionarea sistemului și procesul tehnic de racordare. Pentru situația exactă a programelor de finanțare, îți recomandăm să verifici sursele oficiale de mai sus.
        </p>
        <a href={`${base}/contact/`} class="inline-block bg-blue-600 text-white px-10 py-4 rounded-full text-lg font-bold hover:bg-blue-700 transition-all shadow-xl hover:-translate-y-1">
          Solicită consultanță tehnică
        </a>
      </section>
    </article>
  </main>
</Layout>
